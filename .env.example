# 飞书企业自建应用凭证（必填，禁止提交真实值）
FEISHU_APP_ID=<app-id>
FEISHU_APP_SECRET=<app-secret>

# 首次接入：设为 1，启动后给机器人发消息，从日志复制 openId/chatId；发现模式不会执行任何命令
FEISHU_DISCOVERY=1
# 正式运行：填 open_id，多个用英文逗号分隔，并把 FEISHU_DISCOVERY 改为 0
FEISHU_ALLOWED_OPEN_IDS=
# 可选：只允许指定会话，多个 chat_id 用英文逗号分隔
# FEISHU_ALLOWED_CHAT_IDS=

# Pi 实际工作的项目目录（必填，不要指向本监控项目）
PI_CWD=C:\path\to\project

# 可选
# Windows 默认 pi.cmd；Linux/macOS 默认 pi
# PI_COMMAND=pi.cmd
# PI_SESSION_ID=pi-247
# PI_ARGS_JSON='["--provider","openai","--model","your-model"]'
# PI_AUTOSTART=1
# PI_RESUME_PROMPT=/goal continue
# PI_APPROVAL_TIMEOUT_MS=600000
# PI_SEND_ASSISTANT_TEXT=1
# PI_STATE_FILE=C:\secure\path\pi-monitor-state.json
# PI_EXTENSION=C:\path\to\pi-feishu-monitor\extensions\pi-monitor.ts
